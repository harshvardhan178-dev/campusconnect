# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Database URI
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/campusconnect?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://your_username:your_password@cluster.mongodb.net/campusconnect?retryWrites=true&w=majority

# JWT Authentication Secrets
JWT_SECRET=campusconnect_super_secret_jwt_key_2026
JWT_EXPIRE=7d

# Client URL (for CORS policy)
CLIENT_URL=http://localhost:5173
